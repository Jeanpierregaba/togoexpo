# Copier en deploy/.env sur le serveur, puis remplacer chaque change_me.
# Mots de passe et secret : `openssl rand -base64 33 | tr -d '/+=' | cut -c1-40`
# (lettres et chiffres seulement : les valeurs sont recopiées dans wp-config.php).

# Domaines. Avant le DNS : togoexpo.<ip-en-tirets>.sslip.io et cms.<ip-en-tirets>.sslip.io.
SITE_DOMAIN=togoexpo.org
CMS_DOMAIN=cms.togoexpo.org
# Adresse prévenue par Let's Encrypt en cas de problème de certificat.
ACME_EMAIL=change_me@togoexpo.tg

# Base de données WordPress.
MYSQL_DATABASE=togoexpo
MYSQL_USER=togoexpo
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# Premier compte administrateur (scripts/wp-init.sh).
WP_ADMIN_USER=change_me
WP_ADMIN_PASSWORD=change_me
WP_ADMIN_EMAIL=change_me@togoexpo.tg

# Secret partagé : WordPress prévient le front à chaque publication.
REVALIDATE_SECRET=change_me

# Formulaire de contact (Resend). Sans clé, les messages ne partent pas.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@togoexpo.tg

# Mesure d'audience (Umami). Tableau de bord : STATS_DOMAIN (enregistrement DNS A
# vers l'IP du serveur). Deux valeurs aléatoires, même recette que ci-dessus.
STATS_DOMAIN=stats.togoexpo.org
UMAMI_DB_PASSWORD=change_me
UMAMI_APP_SECRET=change_me
