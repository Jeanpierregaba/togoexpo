# Certificats HTTPS obtenus et renouvelés automatiquement (Let's Encrypt),
# dès que les domaines pointent vers ce serveur.
{
	email {$ACME_EMAIL}
}

# Le site public.
{$SITE_DOMAIN} {
	encode zstd gzip
	# L'administration WordPress est sur le CMS : on y renvoie les anciennes adresses.
	@admin path /wp-admin /wp-admin/* /wp-login.php
	redir @admin https://{$CMS_DOMAIN}{uri} 302

	# Mesure d'audience servie depuis le site lui-même : le script Umami et
	# l'envoi des données, rien d'autre (le tableau de bord est sur STATS_DOMAIN).
	@umami path /_a/script.js /_a/api/send
	handle @umami {
		uri strip_prefix /_a
		reverse_proxy umami:3000
	}

	reverse_proxy front:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Le tableau de bord d'audience (Umami), réservé à l'équipe.
{$STATS_DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}

# L'ancien domaine : toutes ses adresses renvoient définitivement (301) vers le
# site, au même chemin. Le DNS de togoexpo.tg pointe déjà vers ce serveur.
togoexpo.tg, www.togoexpo.tg, http://togoexpo.tg, http://www.togoexpo.tg {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Le CMS. Il n'a pas de site public : seuls l'administration, l'API GraphQL et
# les médias répondent ; toute autre adresse renvoie vers le site public.
{$CMS_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 32MB
	}

	# (xmlrpc.php, inutile ici, est donc lui aussi renvoyé vers le site.)
	@public not path /wp-admin* /wp-login.php /wp-json* /graphql* /wp-content/* /wp-includes/* /wp-cron.php /index.php
	redir @public https://{$SITE_DOMAIN}/ 302

	reverse_proxy wordpress:80
}
